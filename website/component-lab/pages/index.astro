      <a href="/fixtures/contact-form/">Open ContactForm fixture</a>
      <a href="/fixtures/contact/">Open Contact-page assembly fixture</a>
      <a href="/fixtures/legal/privacy/">Open Privacy-page fixture</a>
      <a href="/fixtures/legal/imprint/">Open Imprint-page fixture</a>
      <a href="/fixtures/system-404/">Open 404-page fixture</a>
      <a href="/fixtures/base-layout/">Open BaseLayout fixture</a>
      <a href="/fixtures/homepage/">Open Homepage assembly fixture</a>
      <a href="/fixtures/catalogue/">Open catalogue assembly fixture</a>
      <a href="/fixtures/products/intermodal/uno-intermodal-60ft-sgns/"
        >Open product-page assembly fixture</a
      >
      <a href="/fixtures/editorial/engineering-services/"
        >Open Engineering &amp; Services editorial-page fixture</a
      >
      <a href="/fixtures/editorial/projects/"
        >Open Projects editorial-page fixture</a
