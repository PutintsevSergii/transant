---
import ComponentLabLayout from "../layouts/ComponentLabLayout.astro";
---

<ComponentLabLayout
  title="TransANT component lab"
  description="Isolated fixtures for TransANT website components."
>
  <main class="page-frame lab-index">
    <p class="eyebrow">Component lab</p>
    <h1>Isolated, deterministic fixtures</h1>
    <p>
      Fixtures use local assets and explicit data so components can be reviewed
      without production page dependencies.
    </p>
    <nav aria-label="Available fixtures">
      <a href="/fixtures/smoke/">Open foundation smoke fixture</a>
      <a href="/fixtures/brand-logo/">Open BrandLogo fixture</a>
      <a href="/fixtures/action/">Open Action fixture</a>
      <a href="/fixtures/section-intro/">Open SectionIntro fixture</a>
      <a href="/fixtures/responsive-media/">Open ResponsiveMedia fixture</a>
      <a href="/fixtures/rail-sequence/">Open RailSequence fixture</a>
      <a href="/fixtures/site-header/">Open SiteHeader fixture</a>
      <a href="/fixtures/site-header-repeated/"
        >Open repeated SiteHeader fixture</a
      >
      <a href="/fixtures/site-footer/">Open SiteFooter fixture</a>
      <a href="/fixtures/home-hero/">Open HomeHero fixture</a>
      <a href="/fixtures/railway-orbital/">Open RailwayOrbital fixture</a>
      <a href="/experiments/railway-globe/">Explore dotted globe concept</a>
      <a href="/fixtures/payload-value-section/"
        >Open PayloadValueSection fixture</a
      >
      <a href="/fixtures/wagon-switchyard/">Open WagonSwitchyard fixture</a>
      <a href="/fixtures/modular-platform-section/"
        >Open ModularPlatformSection fixture</a
      >
      <a href="/fixtures/operational-case-study/"
        >Open OperationalCaseStudy fixture</a
      >
      <a href="/fixtures/collaboration-process/"
        >Open CollaborationProcess fixture</a
      >
      <a href="/fixtures/quality-impact-section/"
        >Open QualityImpactSection fixture</a
      >
      <a href="/fixtures/contact-cta/">Open ContactCTA fixture</a>
      <a href="/fixtures/breadcrumbs/">Open Breadcrumbs fixture</a>
      <a href="/fixtures/wagon-family-index/">Open WagonFamilyIndex fixture</a>
      <a href="/fixtures/wagon-model-list/">Open WagonModelList fixture</a>
      <a href="/fixtures/product-hero/">Open ProductHero fixture</a>
      <a href="/fixtures/cargo-fit/">Open CargoFit fixture</a>
      <a href="/fixtures/specification-group/"
        >Open SpecificationGroup fixture</a
      >
      <a href="/fixtures/load-limit-table/">Open LoadLimitTable fixture</a>
      <a href="/fixtures/download-list/">Open DownloadList fixture</a>
      <a href="/fixtures/related-wagons/">Open RelatedWagons fixture</a>
      <a href="/fixtures/page-hero/">Open PageHero fixture</a>
      <a href="/fixtures/page-meta/">Open PageMeta fixture</a>
