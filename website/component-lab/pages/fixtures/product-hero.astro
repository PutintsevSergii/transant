---
import intermodalWagon from "../../../src/assets/images/products/intermodal/uno-intermodal-60ft-sgns/wagon-render.png";
import ProductHero from "../../../src/components/product/ProductHero/ProductHero.astro";
import ComponentLabLayout from "../../layouts/ComponentLabLayout.astro";

const source = {
  reference:
    "src/content/products/intermodal/uno-intermodal-60ft-sgns/product.json",
};
---

<ComponentLabLayout
  title="ProductHero fixture | TransANT component lab"
  description="Static product-detail identity, contained wagon media, facts, and inquiry variants."
>
  <main data-fixture="product-hero">
    <ProductHero
      family="Intermodal wagon"
      code="Sgns(s)"
      title="UNO INTERMODAL 60ft"
      benefit="Flexible intermodal transport with optimized payload capacity."
      inquiryAction={{
        href: "/contact/?source=product-hero#inquiry",
        label: "Discuss this wagon",
      }}
      inquiryContext="UNO INTERMODAL 60ft — Sgns(s)"
      media={{
        image: intermodalWagon,
        alt: "Side-view transparent render of the UNO INTERMODAL 60ft wagon",
        sizes: "(min-width: 60rem) 54vw, 100vw",
        fit: "contain",
        aspectRatio: "16 / 9",
      }}
      facts={[
        { label: "Wagon type", value: "Sgns(s)", source },
        { label: "Length over buffers", value: "19.830 mm", source },
        { label: "Loading length", value: "18.500 mm", source },
      ]}
    />

    <section
      class="product-hero-fixture__alternate page-frame"
      aria-labelledby="alternate-product-hero"
    >
      <p>Single-fact and no-context variant</p>
      <ProductHero
        family="Intermodal wagon"
        code="Sgns(s)"
        title="UNO INTERMODAL 60ft compact inquiry"
        benefit="A deliberately long fixture benefit keeps the product identity and native action readable without relying on a client-side product-page context."
        inquiryAction={{
          href: "/contact/#inquiry",
          label: "Open inquiry route",
          external: false,
        }}
        media={{
          image: intermodalWagon,
          alt: "Side-view transparent render of the UNO INTERMODAL 60ft wagon",
          sizes: "(min-width: 60rem) 54vw, 100vw",
          fit: "contain",
          aspectRatio: "16 / 9",
        }}
        facts={[{ label: "Wagon tare", value: "19.3 t", source }]}
      />
      <h2 id="alternate-product-hero">Optional inquiry context is absent</h2>
    </section>
  </main>
</ComponentLabLayout>

<style>
  .product-hero-fixture__alternate {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-8);
  }

  .product-hero-fixture__alternate > p {
    margin: 0;
    color: var(--color-brand-red-dark);
    font-family: var(--font-mono);
    font-size: var(--font-size-small);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .product-hero-fixture__alternate :global(.product-hero) {
    border: var(--border-thin) solid var(--color-divider);
  }

  .product-hero-fixture__alternate :global(.product-hero__frame) {
    padding-inline: var(--space-5);
  }

  .product-hero-fixture__alternate h2 {
    margin: 0;
    color: var(--color-ink-secondary);
    font-size: var(--font-size-small);
  }
</style>
