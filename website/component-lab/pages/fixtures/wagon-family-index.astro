---
import WagonFamilyIndex from "../../../src/components/catalogue/WagonFamilyIndex/WagonFamilyIndex.astro";
import ComponentLabLayout from "../../layouts/ComponentLabLayout.astro";
import flatWagon from "../../../src/assets/images/products/flat/uno-flat-60ft-rens/wagon-render.png";
import intermodalWagon from "../../../src/assets/images/products/intermodal/uno-intermodal-60ft-sgns/wagon-render.png";
import openBoxWagon from "../../../src/assets/images/products/open-box/uno-multi-56ft-eanos/wagon-render.png";
import tankWagon from "../../../src/assets/images/products/tank/uno-tank-88m3-zacns/wagon-render.png";
import timberWagon from "../../../src/assets/images/products/timber/uno-timber-60ft-rnoos/wagon-render.png";
---

<ComponentLabLayout
  title="WagonFamilyIndex fixture | TransANT component lab"
  description="Five static caller-owned wagon-family rows with direct catalogue routes."
>
  <main data-fixture="wagon-family-index">
    <WagonFamilyIndex
      intro={{
        eyebrow: "Wagon catalogue",
        title: "Five wagon families for distinct freight tasks",
        description:
          "This component-lab fixture uses explicit source-owned presentation data and local reviewed wagon renders. It makes no availability, compatibility, performance, or production-route claim.",
        headingLevel: 2,
        align: "left",
        theme: "light",
        measure: "standard",
      }}
      families={[
        {
          id: "intermodal",
          sequence: "01",
          eyebrow: "Intermodal wagon",
          title: "Intermodal",
          summary:
            "Flexible transport for containers, swap bodies, and intermodal freight units in the caller-owned catalogue record.",
          media: {
            image: intermodalWagon,
            alt: "Local transparent render of an intermodal freight wagon.",
            sizes: "(min-width: 56rem) 48vw, 100vw",
            fit: "contain",
            aspectRatio: "16 / 9",
          },
          href: "/wagons/intermodal/",
          linkLabel: "View Intermodal wagons",
          source: { reference: "Fixture catalogue source" },
        },
        {
          id: "flat",
          sequence: "02",
          eyebrow: "Flat wagon",
          title: "Flat",
          summary:
            "A long source-owned summary covers steel products, timber, construction materials, project cargo, and general industrial goods without turning that source language into an inferred compatibility promise.",
          media: {
            image: flatWagon,
            alt: "Local transparent render of a flat freight wagon.",
            sizes: "(min-width: 56rem) 48vw, 100vw",
            fit: "contain",
            aspectRatio: "16 / 9",
          },
          href: "/wagons/flat/",
          linkLabel: "View Flat wagons",
          source: { reference: "Fixture catalogue source" },
        },
        {
          id: "timber",
          sequence: "03",
          eyebrow: "Timber wagon",
          title: "Timber",
          summary:
            "Specialised transport for timber, wood products, logs, and other long forest-industry loads named by the source record.",
          media: {
            image: timberWagon,
            alt: "Local transparent render of a timber freight wagon.",
            sizes: "(min-width: 56rem) 48vw, 100vw",
            fit: "contain",
            aspectRatio: "16 / 9",
          },
          href: "/wagons/timber/",
          linkLabel: "View Timber wagons",
          source: { reference: "Fixture catalogue source" },
        },
        {
          id: "open-box",
          sequence: "04",
          eyebrow: "Open box wagon",
          title: "Open box",
          summary:
            "Robust open-top handling for bulk material and other source-described loose freight tasks.",
          media: {
            image: openBoxWagon,
            alt: "Local transparent render of an open box freight wagon.",
            sizes: "(min-width: 56rem) 48vw, 100vw",
            fit: "contain",
            aspectRatio: "16 / 9",
          },
          href: "/wagons/open-box/",
          linkLabel: "View Open box wagons",
          source: { reference: "Fixture catalogue source" },
        },
        {
          id: "tank",
          sequence: "05",
          eyebrow: "Tank wagon",
          title: "Tank",
          summary:
            "High-capacity tank-wagon presentation for chemical, petrochemical, and petroleum product categories named in the source record.",
          media: {
            image: tankWagon,
            alt: "Local transparent render of a tank freight wagon.",
            sizes: "(min-width: 56rem) 48vw, 100vw",
            fit: "contain",
            aspectRatio: "16 / 9",
            loading: "eager",
          },
          href: "/wagons/tank/",
          linkLabel: "View Tank wagons",
          source: { reference: "Fixture catalogue source" },
        },
      ]}
    />
  </main>
</ComponentLabLayout>
