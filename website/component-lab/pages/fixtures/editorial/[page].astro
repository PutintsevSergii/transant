---
import {
  editorialPageSlugs,
  editorialPageViewModel,
} from "../../../../src/adapters/content/editorial-page-view-model";
import EvidenceList from "../../../../src/components/editorial/EvidenceList/EvidenceList.astro";
import MediaStory from "../../../../src/components/editorial/MediaStory/MediaStory.astro";
import PageHero from "../../../../src/components/editorial/PageHero/PageHero.astro";
import PageMeta from "../../../../src/components/editorial/PageMeta/PageMeta.astro";
import ContactCTA from "../../../../src/components/home/ContactCTA/ContactCTA.astro";
import OperationalCaseStudy from "../../../../src/components/home/OperationalCaseStudy/OperationalCaseStudy.astro";
import LoadLimitTable from "../../../../src/components/product/LoadLimitTable/LoadLimitTable.astro";
import SpecificationGroup from "../../../../src/components/product/SpecificationGroup/SpecificationGroup.astro";
import TechnicalDetailsNavigation from "../../../../src/components/product/TechnicalDetailsNavigation/TechnicalDetailsNavigation.astro";
import TechnicalSheet from "../../../../src/components/product/TechnicalSheet/TechnicalSheet.astro";
import BaseLayout from "../../../../src/layouts/BaseLayout.astro";

export function getStaticPaths() {
  return editorialPageSlugs.map((page) => ({ params: { page } }));
}

const page = Astro.params.page;
if (!page) {
  throw new Error("Editorial fixtures require a page parameter.");
}

const {
  caseStudy,
  contactCta,
  evidence,
  hero,
  layout,
  loadLimits,
  pageMeta,
  specifications,
  technicalDetailsNavigation,
  technicalSheet,
  stories,
} = editorialPageViewModel(page);
---

<BaseLayout {...layout}>
  <>
    {pageMeta !== undefined && <PageMeta {...pageMeta} />}
    <PageHero {...hero} />
    {
      technicalDetailsNavigation !== undefined && (
        <TechnicalDetailsNavigation {...technicalDetailsNavigation} />
      )
    }
    {stories.map((story) => <MediaStory {...story} />)}
    {caseStudy !== undefined && <OperationalCaseStudy {...caseStudy} />}
    {evidence !== undefined && <EvidenceList {...evidence} />}
    {technicalSheet !== undefined && <TechnicalSheet {...technicalSheet} />}
    {specifications !== undefined && <SpecificationGroup {...specifications} />}
    {loadLimits !== undefined && <LoadLimitTable {...loadLimits} />}
    <ContactCTA {...contactCta} />
  </>
</BaseLayout>
