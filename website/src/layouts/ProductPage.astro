---
import type { ProductPageViewModel } from "../adapters/content/product-view-model";
import Breadcrumbs from "../components/catalogue/Breadcrumbs/Breadcrumbs.astro";
import ContactCTA from "../components/home/ContactCTA/ContactCTA.astro";
import CargoFit from "../components/product/CargoFit/CargoFit.astro";
import ProductHero from "../components/product/ProductHero/ProductHero.astro";
import TechnicalDetailsNavigation from "../components/product/TechnicalDetailsNavigation/TechnicalDetailsNavigation.astro";
import TechnicalSheet from "../components/product/TechnicalSheet/TechnicalSheet.astro";
import BaseLayout from "./BaseLayout.astro";

const {
  layout,
  breadcrumbs,
  hero,
  cargoFit,
  technicalSheet,
  contactCta,
  sectionNavigationLabel,
  technicalDataLabel,
} = Astro.props as ProductPageViewModel;
---

<BaseLayout {...layout}>
  <Breadcrumbs {...breadcrumbs} />
  <ProductHero {...hero} />
  <TechnicalDetailsNavigation
    label={technicalDataLabel}
    navigationLabel={sectionNavigationLabel}
  />
  <CargoFit {...cargoFit} />
  <TechnicalSheet {...technicalSheet} />
  <ContactCTA {...contactCta} />
</BaseLayout>
