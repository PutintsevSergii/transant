---
import Action from "../components/core/Action/Action.astro";
import SectionIntro from "../components/core/SectionIntro/SectionIntro.astro";
import PageHero from "../components/editorial/PageHero/PageHero.astro";
import ContactCTA from "../components/home/ContactCTA/ContactCTA.astro";
import type { InnoTransPageProps } from "./InnoTransPage.types";

type Props = Omit<InnoTransPageProps, "layout">;

const { hero, visit, partners, contactCta } = Astro.props as Props;

if (visit.positions.length !== 4 || partners.items.length !== 2) {
  throw new Error(
    "InnoTransPage requires four official positions and two approved partners.",
  );
}
---

<div class="innotrans-page" data-innotrans-page>
  <PageHero {...hero} />

  <section
    class="innotrans-page__visit"
    aria-label={visit.title}
    data-innotrans-visit
  >
    <div class="innotrans-page__visit-frame page-frame">
      <div class="innotrans-page__visit-copy">
        <SectionIntro
          eyebrow={visit.eyebrow}
          title={visit.title}
          description={visit.summary}
          headingLevel={2}
          align="left"
          theme="light"
          measure="wide"
        />

        <dl class="innotrans-page__facts">
          {
            visit.facts.map((fact) => (
              <div>
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))
          }
        </dl>

        <div class="innotrans-page__visit-actions">
          {visit.actions.map((action) => <Action {...action} />)}
        </div>
      </div>

      <div class="innotrans-page__orientation">
        <figure class="innotrans-page__map">
          <div class="innotrans-page__map-header">
            <strong>{visit.map.title}</strong>
            <span>{visit.map.caption}</span>
          </div>
          <svg
            viewBox="0 0 760 420"
            role="img"
            aria-labelledby="innotrans-map-title innotrans-map-description"
          >
            <title id="innotrans-map-title">{visit.map.title}</title>
            <desc id="innotrans-map-description">{visit.map.caption}</desc>
            <defs>
              <pattern
                id="innotrans-grid"
                width="32"
                height="32"
                patternUnits="userSpaceOnUse"
              >
                <path d="M32 0H0V32" fill="none"></path>
              </pattern>
            </defs>
            <rect class="innotrans-page__map-grid" width="760" height="420"
            ></rect>
            <path class="innotrans-page__map-zone" d="M48 45h250v130H48z"
            ></path>
            <text class="innotrans-page__map-zone-label" x="72" y="80">
              {visit.map.outdoorLabel}
            </text>
            <path class="innotrans-page__map-track" d="M76 246h616"></path>
            <path class="innotrans-page__map-track" d="M76 274h616"></path>
            <text class="innotrans-page__map-track-label" x="76" y="225">
              {visit.map.trackLabel}
            </text>

            <g class="innotrans-page__map-node innotrans-page__map-node--main">
              <circle cx="182" cy="132" r="25"></circle>
              <text x="182" y="137">O5/55</text>
            </g>
            <g class="innotrans-page__map-node">
              <circle cx="290" cy="260" r="25"></circle>
              <text x="290" y="265">T5/50</text>
            </g>
            <g class="innotrans-page__map-node">
              <circle cx="438" cy="260" r="25"></circle>
              <text x="438" y="265">T5/55</text>
            </g>
            <g class="innotrans-page__map-node">
              <circle cx="586" cy="260" r="25"></circle>
              <text x="586" y="265">T5/60</text>
            </g>

            <path class="innotrans-page__map-entrance" d="M336 388h88"></path>
            <path class="innotrans-page__map-entrance" d="m354 370-18 18 18 18"
            ></path>
            <path class="innotrans-page__map-entrance" d="m406 370 18 18-18 18"
            ></path>
            <text class="innotrans-page__map-entrance-label" x="380" y="350">
              {visit.map.entranceLabel}
            </text>
          </svg>
        </figure>

        <nav aria-label={visit.positionListLabel}>
          <ul class="innotrans-page__positions">
            {
              visit.positions.map((position) => (
                <li>
                  <div>
                    <strong>{position.code}</strong>
                    <span>{position.role}</span>
                  </div>
                  <Action {...position.action} />
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </div>
  </section>

  <section
    class="innotrans-page__partners"
    aria-label={partners.title}
    data-innotrans-partners
  >
    <div class="innotrans-page__partners-frame page-frame">
      <SectionIntro
        eyebrow={partners.eyebrow}
        title={partners.title}
        description={partners.summary}
        headingLevel={2}
        align="left"
        theme="light"
        measure="wide"
      />

      <div class="innotrans-page__partner-grid">
        {
          partners.items.map((partner) => (
            <article class="innotrans-page__partner">
              <div class="innotrans-page__partner-logo">
                <img
                  src={partner.logo.src}
                  width={partner.logo.width}
                  height={partner.logo.height}
                  alt={partner.logoAlt}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="innotrans-page__partner-copy">
                <p>{partner.role}</p>
                <h3>{partner.name}</h3>
                <p>{partner.description}</p>
                <Action {...partner.action} />
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <ContactCTA {...contactCta} />
</div>

<style>
  .innotrans-page {
    overflow: clip;
    background: var(--color-paper-warm);
  }

  .innotrans-page__visit {
    background: var(--color-paper-warm);
  }

  .innotrans-page__visit-frame,
  .innotrans-page__visit-copy,
  .innotrans-page__orientation,
  .innotrans-page__partners-frame,
  .innotrans-page__partner-copy {
    display: grid;
    min-inline-size: 0;
  }

  .innotrans-page__visit-frame,
  .innotrans-page__partners-frame {
    gap: clamp(var(--space-7), 8vw, var(--space-10));
    padding-block: clamp(var(--space-8), 9vw, 8rem);
    padding-block-start: var(
      --section-padding-block-start,
      clamp(var(--space-8), 9vw, 8rem)
    );
  }

  .innotrans-page__visit-copy,
  .innotrans-page__orientation {
    align-content: start;
    gap: var(--space-6);
  }

  .innotrans-page__facts {
    display: grid;
    margin: 0;
    border-block-start: var(--border-thin) solid var(--color-divider);
  }

  .innotrans-page__facts > div {
    display: grid;
    grid-template-columns: minmax(7rem, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-3);
    padding-block: var(--space-3);
    border-block-end: var(--border-thin) solid var(--color-divider);
  }

  .innotrans-page__facts dt,
  .innotrans-page__facts dd {
    margin: 0;
  }

  .innotrans-page__facts dt {
    color: var(--color-ink-secondary);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .innotrans-page__facts dd {
    color: var(--color-brand-blue-dark);
    font-weight: 700;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }

  .innotrans-page__visit-actions {
    display: grid;
    gap: var(--space-3);
  }

  .innotrans-page__visit-actions :global(.action) {
    inline-size: 100%;
  }

  .innotrans-page__map {
    margin: 0;
    overflow: hidden;
    border: var(--border-thin) solid rgb(184 208 224 / 24%);
    border-radius: var(--radius-medium);
    background: var(--color-footer-navy);
    color: var(--color-paper);
    box-shadow: var(--shadow-medium);
  }

  .innotrans-page__map-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    padding: var(--space-4);
    border-block-end: var(--border-thin) solid rgb(184 208 224 / 24%);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .innotrans-page__map-header span {
    color: var(--color-railway-muted);
  }

  .innotrans-page__map svg {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }

  .innotrans-page__map-grid {
    fill: url(#innotrans-grid);
    stroke: rgb(184 208 224 / 16%);
  }

  .innotrans-page__map :global(#innotrans-grid path) {
    stroke: rgb(184 208 224 / 10%);
  }

  .innotrans-page__map-zone {
    fill: rgb(28 111 156 / 18%);
    stroke: rgb(184 208 224 / 44%);
    stroke-dasharray: 8 8;
  }

  .innotrans-page__map-zone-label,
  .innotrans-page__map-track-label,
  .innotrans-page__map-entrance-label {
    fill: var(--color-railway-muted);
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .innotrans-page__map-track {
    fill: none;
    stroke: rgb(184 208 224 / 65%);
    stroke-width: 3;
  }

  .innotrans-page__map-node circle {
    fill: var(--color-brand-red-dark);
    stroke: var(--color-paper);
    stroke-width: 3;
  }

  .innotrans-page__map-node--main circle {
    fill: var(--color-brand-blue);
    stroke: var(--color-brand-red);
    stroke-width: 6;
  }

  .innotrans-page__map-node text {
    fill: var(--color-paper);
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 800;
    text-anchor: middle;
  }

  .innotrans-page__map-entrance {
    fill: none;
    stroke: var(--color-brand-red);
    stroke-linecap: square;
    stroke-width: 5;
  }

  .innotrans-page__map-entrance-label {
    text-anchor: middle;
  }

  .innotrans-page__positions {
    display: grid;
    margin: 0;
    padding: 0;
    border-block-start: var(--border-thin) solid var(--color-divider);
    list-style: none;
  }

  .innotrans-page__positions li {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-4);
    border-block-end: var(--border-thin) solid var(--color-divider);
  }

  .innotrans-page__positions li > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .innotrans-page__positions strong {
    color: var(--color-brand-blue-dark);
    font-family: var(--font-mono);
    font-size: 1rem;
  }

  .innotrans-page__positions span {
    color: var(--color-ink-secondary);
    font-size: var(--font-size-small);
  }

  .innotrans-page__positions :global(.action) {
    justify-content: space-between;
  }

  .innotrans-page__partners {
    border-block-start: var(--border-thin) solid var(--color-divider);
    background: var(--color-paper);
  }

  .innotrans-page__partners-frame {
    gap: var(--space-7);
  }

  .innotrans-page__partner-grid {
    display: grid;
    gap: var(--space-4);
  }

  .innotrans-page__partner {
    display: grid;
    min-inline-size: 0;
    border: var(--border-thin) solid var(--color-divider);
    border-radius: var(--radius-medium);
    background: var(--color-paper-warm);
    overflow: hidden;
  }

  .innotrans-page__partner-logo {
    display: grid;
    min-block-size: 10rem;
    place-items: center;
    padding: clamp(var(--space-5), 6vw, var(--space-7));
    border-block-end: var(--border-thin) solid var(--color-divider);
    background: #fff;
  }

  .innotrans-page__partner-logo img {
    inline-size: min(100%, 18rem);
    block-size: auto;
    max-block-size: 5rem;
    object-fit: contain;
  }

  .innotrans-page__partner-copy {
    align-content: start;
    justify-items: start;
    gap: var(--space-3);
    padding: clamp(var(--space-5), 5vw, var(--space-6));
  }

  .innotrans-page__partner-copy p,
  .innotrans-page__partner-copy h3 {
    margin: 0;
  }

  .innotrans-page__partner-copy > p:first-child {
    color: var(--color-brand-red-dark);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .innotrans-page__partner-copy h3 {
    color: var(--color-brand-blue-dark);
    font-size: clamp(1.35rem, 4vw, 2rem);
    line-height: 1.1;
    overflow-wrap: anywhere;
  }

  .innotrans-page__partner-copy > p:not(:first-child) {
    color: var(--color-ink-secondary);
    line-height: var(--line-height-body);
  }

  @media (min-width: 34rem) {
    .innotrans-page__visit-actions {
      display: flex;
      flex-wrap: wrap;
    }

    .innotrans-page__visit-actions :global(.action) {
      inline-size: auto;
    }

    .innotrans-page__positions li {
      grid-template-columns: minmax(9rem, 0.55fr) minmax(0, 1.45fr);
      align-items: center;
    }
  }

  @media (min-width: 48rem) {
    .innotrans-page__partner-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 62rem) {
    .innotrans-page__visit-frame {
      grid-template-columns: minmax(19rem, 0.78fr) minmax(0, 1.22fr);
      align-items: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .innotrans-page *,
    .innotrans-page *::before,
    .innotrans-page *::after {
      scroll-behavior: auto;
    }
  }
</style>
