---
import { catalogueIndexViewModel } from "../../adapters/content/catalogue-view-model";
import Breadcrumbs from "../../components/catalogue/Breadcrumbs/Breadcrumbs.astro";
import WagonFamilyIndex from "../../components/catalogue/WagonFamilyIndex/WagonFamilyIndex.astro";
import PageHero from "../../components/editorial/PageHero/PageHero.astro";
import PageMeta from "../../components/editorial/PageMeta/PageMeta.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const { breadcrumbs, familyIndex, hero, layout, pageMeta } =
  catalogueIndexViewModel;
---

<BaseLayout {...layout}>
  <PageMeta {...pageMeta} />
  <PageHero {...hero}>
    <Breadcrumbs slot="breadcrumbs" {...breadcrumbs} />
  </PageHero>
  <WagonFamilyIndex {...familyIndex} />
</BaseLayout>
