---
import {
  catalogueFamilySlugs,
  catalogueFamilyViewModel,
  catalogueIndexViewModel,
} from "../../adapters/content/catalogue-view-model";
import {
  editorialPageSlugs,
  editorialPageViewModel,
  type EditorialPageSlug,
} from "../../adapters/content/editorial-page-view-model";
import {
  localizeViewModel,
  translateLocalizedContent,
} from "../../adapters/content/localized-view-model";
import {
  contactPageViewModel,
  legalPageSlugs,
  legalPageViewModel,
  notFoundPageViewModel,
} from "../../adapters/content/legal-page-view-model";
import {
  productPageViewModel,
  productRouteParams,
} from "../../adapters/content/product-view-model";
import type { SiteLocale } from "../../adapters/content/site-shell-view-model";
import Breadcrumbs from "../../components/catalogue/Breadcrumbs/Breadcrumbs.astro";
import WagonFamilyIndex from "../../components/catalogue/WagonFamilyIndex/WagonFamilyIndex.astro";
import WagonModelList from "../../components/catalogue/WagonModelList/WagonModelList.astro";
import Action from "../../components/core/Action/Action.astro";
import EvidenceList from "../../components/editorial/EvidenceList/EvidenceList.astro";
import MediaStory from "../../components/editorial/MediaStory/MediaStory.astro";
import PageHero from "../../components/editorial/PageHero/PageHero.astro";
import PageMeta from "../../components/editorial/PageMeta/PageMeta.astro";
import ContactForm from "../../components/form/ContactForm/ContactForm.astro";
import ContactCTA from "../../components/home/ContactCTA/ContactCTA.astro";
import OperationalCaseStudy from "../../components/home/OperationalCaseStudy/OperationalCaseStudy.astro";
import LegalDocument from "../../components/legal/LegalDocument/LegalDocument.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductPage from "../../layouts/ProductPage.astro";
import TechnologyPage from "../../layouts/TechnologyPage.astro";
import "../../styles/localized-pages.css";

type AdditionalLocale = Extract<SiteLocale, "uk" | "pl" | "cs">;

export function getStaticPaths() {
  const additionalLocales = ["uk", "pl", "cs"] as const;
  const localizedPages = [
    "404",
    "contact",
    ...legalPageSlugs,
    ...editorialPageSlugs,
    "wagons",
    ...catalogueFamilySlugs.map((family) => `wagons/${family}`),
    ...productRouteParams.map(
      ({ family, product }) => `wagons/${family}/${product}`,
    ),
  ];
  return additionalLocales.flatMap((locale) =>
    localizedPages.map((page) => ({ params: { locale, page } })),
  );
}

const locale = Astro.params.locale as AdditionalLocale;
const page = Astro.params.page;
if (!page) throw new Error("Localized routes require a page parameter.");

const isEditorial = (editorialPageSlugs as readonly string[]).includes(page);
const isLegal = (legalPageSlugs as readonly string[]).includes(page);
const pageParts = page.split("/");
const isProduct =
  pageParts.length === 3 &&
  pageParts[0] === "wagons" &&
  productRouteParams.some(
    ({ family, product }) =>
      family === pageParts[1] && product === pageParts[2],
  );
const isFamily =
  pageParts.length === 2 &&
  pageParts[0] === "wagons" &&
  catalogueFamilySlugs.includes(
    pageParts[1] as (typeof catalogueFamilySlugs)[number],
  );

const contact =
  page === "contact"
    ? localizeViewModel(contactPageViewModel, locale)
    : undefined;
const legal = isLegal
  ? localizeViewModel(legalPageViewModel(page), locale)
  : undefined;
const notFound =
  page === "404" ? localizeViewModel(notFoundPageViewModel, locale) : undefined;
const editorial = isEditorial
  ? localizeViewModel(editorialPageViewModel(page as EditorialPageSlug), locale)
  : undefined;
const catalogueIndex =
  page === "wagons"
    ? localizeViewModel(catalogueIndexViewModel, locale)
    : undefined;
const catalogueFamily = isFamily
  ? localizeViewModel(catalogueFamilyViewModel(pageParts[1]!), locale)
  : undefined;
const product = isProduct
  ? localizeViewModel(
      productPageViewModel(pageParts[1]!, pageParts[2]!),
      locale,
    )
  : undefined;
const t = (source: string) => translateLocalizedContent(source, locale);
---

{
  contact && (
    <BaseLayout {...contact.layout}>
      <PageHero {...contact.hero} />
      <section class="contact-page" data-contact-page>
        <div class="contact-page__frame page-frame">
          <div class="contact-page__details">
            <p class="contact-page__eyebrow">{t("Direct contact")}</p>
            <h2>{t("Contact details")}</h2>
            <address>
              {contact.addressLines.map((line) => (
                <span>{line}</span>
              ))}
            </address>
            <a href={`tel:${contact.phone.replace(/[\s().-]/gu, "")}`}>
              {contact.phone}
            </a>
            <a href={`mailto:${contact.email}`}>{contact.email}</a>
          </div>
          <ContactForm {...contact.form} />
        </div>
      </section>
    </BaseLayout>
  )
}

{
  legal && (
    <BaseLayout {...legal.layout}>
      <PageHero {...legal.hero} />
      <LegalDocument {...legal.document} />
    </BaseLayout>
  )
}

{
  notFound && (
    <BaseLayout {...notFound.layout}>
      <section class="not-found" data-not-found-page>
        <div class="not-found__frame page-frame">
          <p class="not-found__eyebrow">404</p>
          <h1>{notFound.title}</h1>
          <p>{notFound.description}</p>
          <nav aria-label={t("Recovery pages")} class="not-found__actions">
            {notFound.recoveryLinks.map((link, index) => (
              <Action
                kind="link"
                href={link.href}
                label={link.label}
                variant={index === 0 ? "primary" : "secondary"}
                size="regular"
                icon="arrow-right"
              />
            ))}
          </nav>
        </div>
      </section>
    </BaseLayout>
  )
}

{
  editorial && (
    <BaseLayout {...editorial.layout}>
      {page === "technology" ? (
        <TechnologyPage
          hero={editorial.hero}
          stories={editorial.stories}
          contactCta={editorial.contactCta}
        />
      ) : (
        <>
          {editorial.pageMeta !== undefined && (
            <PageMeta {...editorial.pageMeta} />
          )}
          <PageHero {...editorial.hero} />
          {editorial.stories.map((story) => (
            <MediaStory {...story} />
          ))}
          {editorial.caseStudy !== undefined && (
            <OperationalCaseStudy {...editorial.caseStudy} />
          )}
          {editorial.evidence !== undefined && (
            <EvidenceList {...editorial.evidence} />
          )}
          <ContactCTA {...editorial.contactCta} />
        </>
      )}
    </BaseLayout>
  )
}

{
  catalogueIndex && (
    <BaseLayout {...catalogueIndex.layout}>
      <PageMeta {...catalogueIndex.pageMeta} />
      <PageHero {...catalogueIndex.hero}>
        <Breadcrumbs slot="breadcrumbs" {...catalogueIndex.breadcrumbs} />
      </PageHero>
      <WagonFamilyIndex {...catalogueIndex.familyIndex} />
    </BaseLayout>
  )
}

{
  catalogueFamily && (
    <BaseLayout {...catalogueFamily.layout}>
      <PageHero {...catalogueFamily.hero}>
        <Breadcrumbs slot="breadcrumbs" {...catalogueFamily.breadcrumbs} />
      </PageHero>
      <WagonModelList {...catalogueFamily.modelList} />
    </BaseLayout>
  )
}

{product && <ProductPage {...product} />}
