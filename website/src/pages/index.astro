---
import { homepageViewModel } from "../adapters/content/homepage-view-model";
import ContactCTA from "../components/home/ContactCTA/ContactCTA.astro";
import PageMeta from "../components/editorial/PageMeta/PageMeta.astro";
import HomeHero from "../components/home/HomeHero/HomeHero.astro";
import InnoTransEvent from "../components/home/InnoTransEvent/InnoTransEvent.astro";
import ModularPlatformSection from "../components/home/ModularPlatformSection/ModularPlatformSection.astro";
import PayloadValueSection from "../components/home/PayloadValueSection/PayloadValueSection.astro";
import QualityImpactSection from "../components/home/QualityImpactSection/QualityImpactSection.astro";
import RailwayOrbital from "../components/home/RailwayOrbital/RailwayOrbital.astro";
import WagonSwitchyard from "../components/home/WagonSwitchyard/WagonSwitchyard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const {
  contactCta,
  hero,
  innoTransEvent,
  layout,
  pageMeta,
  payload,
  platform,
  qualityImpact,
  switchyard,
} = homepageViewModel;
---

<BaseLayout {...layout}>
  <PageMeta {...pageMeta} />
  <HomeHero {...hero} />
  <InnoTransEvent {...innoTransEvent} />
  <WagonSwitchyard {...switchyard} />
  <PayloadValueSection {...payload}>
    <RailwayOrbital
      slot="visual"
      motion="auto"
      density="standard"
      accent="blue"
    />
  </PayloadValueSection>
  <ModularPlatformSection {...platform} />
  <QualityImpactSection {...qualityImpact} />
  <ContactCTA {...contactCta} />
</BaseLayout>
