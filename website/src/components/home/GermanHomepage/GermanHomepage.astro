---
import { germanHomepageViewModel } from "../../../adapters/content/german-homepage-view-model";
import ContactCTA from "../ContactCTA/ContactCTA.astro";
import PageMeta from "../../editorial/PageMeta/PageMeta.astro";
import HomeHero from "../HomeHero/HomeHero.astro";
import InnoTransEvent from "../InnoTransEvent/InnoTransEvent.astro";
import ModularPlatformSection from "../ModularPlatformSection/ModularPlatformSection.astro";
import PayloadValueSection from "../PayloadValueSection/PayloadValueSection.astro";
import QualityImpactSection from "../QualityImpactSection/QualityImpactSection.astro";
import RailwayOrbital from "../RailwayOrbital/RailwayOrbital.astro";
import WagonSwitchyard from "../WagonSwitchyard/WagonSwitchyard.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";

const {
  contactCta,
  hero,
  innoTransEvent,
  layout,
  pageMeta,
  payload,
  platform,
  qualityImpact,
  switchyard,
} = germanHomepageViewModel;
---

<BaseLayout {...layout}>
  <PageMeta {...pageMeta} />
  <HomeHero {...hero} />
  <InnoTransEvent {...innoTransEvent} />
  <WagonSwitchyard {...switchyard} />
  <PayloadValueSection {...payload}>
    <RailwayOrbital
      slot="visual"
      motion="auto"
      density="standard"
      accent="blue"
    />
  </PayloadValueSection>
  <ModularPlatformSection {...platform} />
  <QualityImpactSection {...qualityImpact} />
  <ContactCTA {...contactCta} />
</BaseLayout>
