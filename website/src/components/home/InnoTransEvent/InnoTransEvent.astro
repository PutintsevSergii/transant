---
import Action from "../../core/Action/Action.astro";
import type { InnoTransEventProps } from "./InnoTransEvent.types";

const {
  id,
  eyebrow,
  title,
  summary,
  date,
  startDate,
  location,
  action,
  standLocations,
} = Astro.props as InnoTransEventProps;

if (standLocations.items.length !== 4) {
  throw new Error("InnoTransEvent requires exactly four confirmed positions.");
}
---

<section
  id={id}
  class="innotrans-event"
  data-innotrans-event
  aria-labelledby={`${id}-title`}
>
  <div class="innotrans-event__frame page-frame">
    <div class="innotrans-event__content">
      <p class="innotrans-event__eyebrow">
        <span aria-hidden="true"></span>
        {eyebrow}
      </p>
      <h2 id={`${id}-title`} class="innotrans-event__title">{title}</h2>
      <p class="innotrans-event__summary">{summary}</p>

      <div class="innotrans-event__details">
        <span class="innotrans-event__calendar" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false">
            <path
              d="M7 3v3M17 3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v14H4V6a1 1 0 0 1 1-1Z"
            ></path>
          </svg>
        </span>
        <span class="innotrans-event__date-place">
          <time datetime={startDate}>{date}</time>
          <span>{location}</span>
        </span>
      </div>

      <div class="innotrans-event__action">
        <Action {...action} />
      </div>
    </div>

    <div class="innotrans-event__locations" data-innotrans-locations>
      <header class="innotrans-event__locations-header">
        <p>{standLocations.eyebrow}</p>
        <h3>{standLocations.title}</h3>
      </header>
      <nav aria-label={standLocations.navigationLabel}>
        <ul class="innotrans-event__locations-list">
          {
            standLocations.items.map((item) => (
              <li>
                <div class="innotrans-event__location-identity">
                  <strong>{item.code}</strong>
                  <span>{item.role}</span>
                </div>
                <Action {...item.action} />
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</section>

<style>
  .innotrans-event {
    position: relative;
    container-type: inline-size;
    overflow: clip;
    border-block-end: var(--border-thin) solid var(--color-railway-border);
    color: var(--color-paper);
    background: var(--color-footer-navy);
  }

  .innotrans-event__frame {
    position: relative;
    display: grid;
    gap: var(--space-7);
    align-items: center;
    padding-block: clamp(var(--space-7), 7vw, 5.5rem);
  }

  .innotrans-event__content {
    display: grid;
    min-inline-size: 0;
    justify-items: start;
    gap: var(--space-4);
  }

  .innotrans-event__eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0;
    color: var(--color-railway-pale);
    font-family: var(--font-mono);
    font-size: clamp(0.72rem, 1.7cqi, 0.85rem);
    font-weight: 700;
    letter-spacing: 0.11em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .innotrans-event__eyebrow > span {
    flex: 0 0 auto;
    inline-size: 0.55rem;
    block-size: 0.55rem;
    border-radius: 50%;
    background: var(--color-brand-red);
  }

  .innotrans-event__title {
    max-inline-size: 16ch;
    margin: 0;
    color: var(--color-paper);
    font-size: clamp(2rem, 6cqi, 4rem);
    letter-spacing: -0.04em;
    line-height: 1.02;
    text-wrap: balance;
  }

  .innotrans-event__summary {
    max-inline-size: 62ch;
    margin: 0;
    color: #d7e5ee;
    font-size: clamp(1rem, 2.1cqi, 1.15rem);
    line-height: var(--line-height-body);
  }

  .innotrans-event__details {
    display: inline-flex;
    max-inline-size: 100%;
    align-items: center;
    gap: var(--space-3);
    margin-block-start: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border: var(--border-thin) solid var(--color-railway-border);
    border-radius: var(--radius-medium);
    background: var(--color-railway-navy);
  }

  .innotrans-event__calendar {
    display: grid;
    flex: 0 0 auto;
    inline-size: 2.25rem;
    block-size: 2.25rem;
    place-items: center;
    border: var(--border-thin) solid rgb(220 28 59 / 55%);
    border-radius: var(--radius-small);
    color: var(--color-brand-red);
    background: var(--color-railway-blue);
  }

  .innotrans-event__calendar svg {
    inline-size: 1.25rem;
    fill: none;
    stroke: currentcolor;
    stroke-linecap: square;
    stroke-width: 1.7;
  }

  .innotrans-event__date-place {
    display: grid;
    min-inline-size: 0;
    gap: var(--space-1);
    font-family: var(--font-mono);
  }

  .innotrans-event__date-place time {
    color: var(--color-paper);
    font-size: clamp(0.86rem, 2cqi, 1rem);
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  .innotrans-event__date-place > span {
    color: var(--color-railway-pale);
    font-size: 0.75rem;
    letter-spacing: 0.09em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .innotrans-event__action {
    inline-size: 100%;
    margin-block-start: var(--space-3);
  }

  .innotrans-event__action :global(.action) {
    inline-size: 100%;
    min-block-size: 3.25rem;
    text-transform: uppercase;
  }

  .innotrans-event__locations {
    min-inline-size: 0;
    padding: clamp(var(--space-4), 4cqi, var(--space-6));
    border: var(--border-thin) solid var(--color-railway-border);
    border-radius: 0.75rem;
    background: rgb(16 46 73 / 82%);
    box-shadow: 0 1rem 2rem rgb(0 0 0 / 12%);
  }

  .innotrans-event__locations-header {
    display: grid;
    gap: var(--space-2);
    padding-block-end: var(--space-4);
    border-block-end: var(--border-thin) solid var(--color-railway-border);
  }

  .innotrans-event__locations-header p,
  .innotrans-event__locations-header h3 {
    margin: 0;
  }

  .innotrans-event__locations-header p {
    color: var(--color-railway-pale);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .innotrans-event__locations-header h3 {
    color: var(--color-paper);
    font-size: clamp(1.5rem, 4cqi, 2.25rem);
    line-height: 1.08;
  }

  .innotrans-event__locations-list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .innotrans-event__locations-list li {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-3);
    border-block-end: var(--border-thin) solid var(--color-railway-border);
  }

  .innotrans-event__locations-list li:last-child {
    border-block-end: 0;
    padding-block-end: 0;
  }

  .innotrans-event__location-identity {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .innotrans-event__location-identity strong {
    color: var(--color-paper);
    font-family: var(--font-mono);
    font-size: 1rem;
    letter-spacing: 0.05em;
  }

  .innotrans-event__location-identity span {
    color: var(--color-railway-muted);
    font-size: var(--font-size-small);
  }

  .innotrans-event__locations-list :global(.action) {
    justify-content: space-between;
    color: var(--color-railway-pale);
  }

  @container (min-width: 38rem) {
    .innotrans-event__action {
      inline-size: auto;
    }

    .innotrans-event__action :global(.action) {
      inline-size: auto;
    }
  }

  @container (min-width: 60rem) {
    .innotrans-event__frame {
      grid-template-columns: minmax(0, 7fr) minmax(22rem, 5fr);
      gap: clamp(var(--space-7), 5vw, 5rem);
    }
  }

  @media (forced-colors: active) {
    .innotrans-event,
    .innotrans-event__details,
    .innotrans-event__locations {
      border-color: CanvasText;
    }
  }
</style>
