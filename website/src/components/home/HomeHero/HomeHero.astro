---
import Action from "../../core/Action/Action.astro";
import ResponsiveMedia from "../../core/ResponsiveMedia/ResponsiveMedia.astro";
import type { HomeHeroProps } from "./HomeHero.types";

const { eyebrow, title, summary, primaryAction, secondaryLink, media } =
  Astro.props as HomeHeroProps;
---

<section class="home-hero" data-home-hero>
  <div class="home-hero__grid page-frame">
    <div class="home-hero__content">
      <p class="home-hero__eyebrow">{eyebrow}</p>
      <h1 class="home-hero__title">
        {
          title.map((segment) =>
            segment.emphasis ? (
              <span class="home-hero__emphasis">{segment.text}</span>
            ) : (
              <span>{segment.text}</span>
            ),
          )
        }
      </h1>
      <p class="home-hero__summary">{summary}</p>
      <div class="home-hero__actions">
        <Action {...primaryAction} />
        {secondaryLink && <Action {...secondaryLink} />}
      </div>
    </div>
    <div class="home-hero__media" data-home-hero-media>
      <ResponsiveMedia {...media} priority />
    </div>
  </div>
</section>

<style>
  .home-hero {
    container-type: inline-size;
    overflow: clip;
    border-block-end: var(--border-thin) solid var(--color-divider);
    background: var(--color-paper);
  }

  .home-hero__grid {
    display: grid;
    gap: var(--space-6);
    align-items: center;
    padding-block: clamp(var(--space-7), 9vw, var(--space-10));
  }

  .home-hero__content {
    display: grid;
    gap: var(--space-5);
    min-inline-size: 0;
  }

  .home-hero__eyebrow {
    margin: 0;
    color: var(--color-brand-red-dark);
    font-family: var(--font-mono);
    font-size: var(--font-size-small);
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .home-hero__title {
    max-inline-size: 12ch;
    margin: 0;
    color: var(--color-brand-blue-dark);
    font-size: clamp(2.75rem, 5.5cqi, 5.5rem);
    font-weight: 700;
    letter-spacing: -0.055em;
    line-height: 0.94;
    text-wrap: balance;
  }

  .home-hero__title > span {
    display: inline;
  }

  .home-hero__emphasis {
    color: var(--color-brand-red-dark);
  }

  .home-hero__summary {
    max-inline-size: 55ch;
    margin: 0;
    color: var(--color-ink-secondary);
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: var(--line-height-body);
  }

  .home-hero__actions {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
  }

  .home-hero__actions :global(.action--primary) {
    inline-size: 100%;
  }

  .home-hero__media {
    min-inline-size: 0;
  }

  .home-hero__media :global(.responsive-media) {
    gap: var(--space-3);
  }

  .home-hero__media :global(img) {
    min-block-size: 17rem;
    object-position: 60% center;
  }

  @container (min-width: 30rem) {
    .home-hero__actions :global(.action--primary) {
      inline-size: auto;
    }
  }

  @container (min-width: 56rem) {
    .home-hero__grid {
      grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
      gap: clamp(var(--space-7), 7vw, var(--space-10));
    }

    .home-hero__media {
      align-self: stretch;
    }

    .home-hero__media :global(.responsive-media),
    .home-hero__media :global(picture),
    .home-hero__media :global(img) {
      block-size: 100%;
    }

    .home-hero__media :global(img) {
      min-block-size: 36rem;
      object-position: right center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero__title {
      text-wrap: wrap;
    }
  }
</style>
