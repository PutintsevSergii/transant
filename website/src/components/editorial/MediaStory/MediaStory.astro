---
import Action from "../../core/Action/Action.astro";
import ResponsiveMedia from "../../core/ResponsiveMedia/ResponsiveMedia.astro";
import SectionIntro from "../../core/SectionIntro/SectionIntro.astro";
import { validateMediaStoryProps } from "./media-story-contract";
import type { MediaStoryProps } from "./MediaStory.types";

const props = Astro.props as MediaStoryProps;
validateMediaStoryProps(props);

const mediaPosition = props.mediaPosition ?? "after";
const spacing = props.spacing ?? "standard";
const headingSize = props.headingSize ?? "standard";
const rootClass = `media-story media-story--${props.theme} media-story--spacing-${spacing} media-story--heading-${headingSize}${props.media ? " media-story--with-media" : " media-story--without-media"}`;
const actionVariant = props.theme === "dark" ? "inverse" : "secondary";
---

<section
  class={rootClass}
  data-media-story
  data-media-story-theme={props.theme}
  data-media-story-media-position={mediaPosition}
  data-media-story-spacing={spacing}
  data-media-story-heading-size={headingSize}
>
  <div class="media-story__frame page-frame" data-media-story-frame>
    {
      props.media && mediaPosition === "before" && (
        <div class="media-story__media" data-media-story-media>
          <ResponsiveMedia {...props.media} />
        </div>
      )
    }
    <div class="media-story__content" data-media-story-content>
      <SectionIntro
        eyebrow={props.eyebrow}
        title={props.title}
        description={props.description}
        headingLevel={props.headingLevel}
        align="left"
        theme={props.theme}
        measure="standard"
      />
      {
        props.paragraphs?.map((paragraph) => (
          <p class="media-story__paragraph">{paragraph}</p>
        ))
      }
      {
        props.items && (
          <ul class="media-story__list">
            {props.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )
      }
      {
        props.action && (
          <Action
            kind="link"
            variant={actionVariant}
            size="regular"
            icon="arrow-right"
            href={props.action.href}
            label={props.action.label}
            external={props.action.external}
          />
        )
      }
    </div>
    {
      props.media && mediaPosition === "after" && (
        <div class="media-story__media" data-media-story-media>
          <ResponsiveMedia {...props.media} />
        </div>
      )
    }
  </div>
</section>

<style>
  .media-story {
    container-type: inline-size;
    overflow: clip;
  }

  .media-story--light {
    background: var(--color-paper);
  }

  .media-story--dark {
    background: var(--color-brand-blue-dark);
  }

  .media-story__frame,
  .media-story__content,
  .media-story__media {
    min-inline-size: 0;
  }

  .media-story__frame {
    --media-story-block-inset: clamp(var(--space-7), 10vw, var(--space-10));

    display: grid;
    gap: clamp(var(--space-6), 7vw, var(--space-10));
    align-items: center;
    padding-block: var(--media-story-block-inset);
    padding-block-start: var(
      --section-padding-block-start,
      var(--media-story-block-inset)
    );
  }

  .media-story--without-media .media-story__frame {
    padding-block: clamp(var(--space-7), 10vw, var(--space-8));
  }

  .media-story--spacing-generous-top .media-story__frame {
    padding-block-start: var(
      --section-padding-block-start,
      clamp(2rem, 6vw, 5rem)
    );
  }

  .media-story--without-media.media-story--spacing-generous-top
    .media-story__frame {
    padding-block-start: clamp(2rem, 6vw, 5rem);
  }

  .media-story--heading-compact
    .media-story__content
    :global(.section-intro__title) {
    font-size: clamp(1.625rem, 1.35rem + 1.4vw, 2.5rem);
  }

  .media-story__content {
    display: grid;
    justify-items: start;
    gap: var(--space-5);
  }

  .media-story__paragraph,
  .media-story__list {
    max-inline-size: 62ch;
    margin: 0;
    color: var(--color-ink-secondary);
    line-height: var(--line-height-body);
    overflow-wrap: anywhere;
  }

  .media-story--dark .media-story__paragraph,
  .media-story--dark .media-story__list {
    color: var(--color-railway-pale);
  }

  .media-story__list {
    display: grid;
    gap: var(--space-3);
    padding-inline-start: 1.25rem;
  }

  .media-story__content > :global(.action) {
    inline-size: 100%;
  }

  .media-story__media {
    overflow: hidden;
    border: var(--border-thin) solid var(--color-divider);
    background: var(--color-surface-subtle);
  }

  .media-story--dark .media-story__media {
    border-color: color-mix(in srgb, var(--color-paper) 36%, transparent);
    background: var(--color-footer-navy);
  }

  .media-story__media :global(.responsive-media),
  .media-story__media :global(picture),
  .media-story__media :global(img) {
    inline-size: 100%;
  }

  .media-story__media :global(img) {
    min-block-size: clamp(15rem, 58cqi, 28rem);
    object-position: center;
  }

  .media-story__media :global(.responsive-media__caption) {
    color: var(--color-ink-secondary);
    padding-inline: var(--space-4);
    padding-block-end: var(--space-4);
    background: var(--color-paper);
  }

  .media-story__media
    :global(.responsive-media--reserved:has(.responsive-media__caption)) {
    aspect-ratio: auto;
  }

  @container (min-width: 30rem) {
    .media-story__content > :global(.action) {
      inline-size: auto;
    }
  }

  @container (min-width: 58rem) {
    .media-story--with-media.media-story--spacing-standard .media-story__frame {
      padding-block: 0;
    }

    .media-story--with-media .media-story__frame {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(var(--space-6), 7vw, var(--space-8));
    }

    .media-story--without-media .media-story__content {
      max-inline-size: 46rem;
    }

    .media-story__media :global(img) {
      min-block-size: 30rem;
    }
  }
</style>
