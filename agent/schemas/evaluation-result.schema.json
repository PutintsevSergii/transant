{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TransANT independent evaluation result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "work_package",
    "verdict",
    "review_file",
    "checks",
    "acceptance_gaps",
    "state_synchronized",
    "next_action"
  ],
  "properties": {
    "work_package": {
      "type": "string",
      "pattern": "^(F|C|H|P|E|A|I)-[0-9]{3}$"
    },
    "verdict": {
      "type": "string",
      "enum": ["PASS", "FAIL", "BLOCKED"]
    },
    "review_file": { "type": "string", "minLength": 1 },
    "checks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "acceptance_gaps": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "state_synchronized": { "type": "boolean" },
    "next_action": { "type": "string", "minLength": 1 }
  }
}
